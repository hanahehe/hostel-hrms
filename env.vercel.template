# Production — copy these into Vercel → Settings → Environment Variables
# https://hostel-hrms.vercel.app

NEXT_PUBLIC_APP_URL=https://hostel-hrms.vercel.app

# Required: generate with: openssl rand -base64 32
JWT_SECRET=replace-with-a-long-random-secret

# CORS (comma-separated origins allowed to call /api)
CORS_ALLOWED_ORIGINS=https://hostel-hrms.vercel.app,http://localhost:3000

# Optional: custom admin login
# ADMIN_EMAIL=hana@gmail.com
# ADMIN_PASSWORD=your-password
# ADMIN_ROLE=admin
# ADMIN_NAME=Hana

# Optional: Supabase
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
